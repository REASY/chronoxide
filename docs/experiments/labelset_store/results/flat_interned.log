[kafka]
brokers = ["localhost:9092"]
group_id = "chronoxide-ingester"
topic = "otlp_metrics"
client_id = "chronoxide-ingester"
session_timeout_ms = 10000
enable_auto_commit = false
auto_offset_reset = "earliest"
max_inflight = 1
fetch_min_bytes = 1
fetch_wait_max_ms = 100

[ingestion]
max_event_age_secs = 3600
max_event_lead_secs = -5
drop_outdated = true
labelset_store = "flat_interned"
labelset_report_interval_secs = 10
replay_from = "/tmp/chronoxide-otlp_all_.capture"
capture_only = false

